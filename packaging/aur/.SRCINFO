pkgbase = pastor-bin
	pkgdesc = Phone web UI for the AI agents running in your terminal, served over Tailscale (official binary release)
	pkgver = 1.20.2
	pkgrel = 1
	url = https://github.com/Ad3Digital/pastor
	install = pastor-bin.install
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
